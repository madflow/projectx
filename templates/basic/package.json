{
  "name": "my-turborepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && knip",
    "test": "turbo run test",
    "format": "oxfmt \"**/*.{ts,tsx,md}\"",
    "format:check": "oxfmt --check \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "check": "pnpm lint && pnpm check-types && pnpm test && pnpm format:check"
  },
  "devDependencies": {
    "@turbo/gen": "2.11.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-turbo": "2.11.5",
    "knip": "6.38.0",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "turbo": "2.11.5",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  }
}
