import {
  AuthProvider,
  createAuthClient,
  useAuthSession,
  useSignInEmail,
  useSignOut,
  useSignUpEmail,
} from "@repo/auth/react";
import { Button } from "@repo/ui/components/button";
import { Login01, type LoginValues } from "@repo/ui/features/login-01";
import { Signup01, type SignupValues } from "@repo/ui/features/signup-01";
import { useState } from "react";

import { ThemeToggle } from "./components/theme-toggle";

const client = createAuthClient();

function AuthContent() {
  const { data: session, isPending, error: sessionError } = useAuthSession();
  const signIn = useSignInEmail();
  const signUp = useSignUpEmail();
  const signOut = useSignOut();
  const [register, setRegister] = useState(false);

  async function login(values: LoginValues) {
    try {
      await signIn.execute(values);
    } catch {
      // The hook exposes the error to the form.
    }
  }

  async function signup(values: SignupValues) {
    try {
      await signUp.execute(values);
    } catch {
      // The hook exposes the error to the form.
    }
  }

  if (isPending)
    return (
      <main className="flex min-h-svh flex-col items-center justify-center gap-6 p-6">
        <ThemeToggle />
        <p>Checking your session…</p>
      </main>
    );

  if (session) {
    return (
      <main className="flex min-h-svh flex-col items-center justify-center gap-6 p-6">
        <ThemeToggle />
        <div className="flex flex-col items-center gap-4 text-center">
          <p>Signed in as {session.user.email}</p>
          <Button
            type="button"
            disabled={signOut.isPending}
            onClick={() => void signOut.execute().catch(() => {})}
          >
            Sign out
          </Button>
          {signOut.error && <p role="alert">{signOut.error.message}</p>}
        </div>
      </main>
    );
  }

  return (
    <main className="flex min-h-svh flex-col items-center justify-center gap-6 p-6">
      <ThemeToggle />
      <div className="flex gap-2" aria-label="Authentication">
        <Button
          type="button"
          variant={register ? "outline" : "default"}
          aria-pressed={!register}
          onClick={() => setRegister(false)}
        >
          Sign in
        </Button>
        <Button
          type="button"
          variant={register ? "default" : "outline"}
          aria-pressed={register}
          onClick={() => setRegister(true)}
        >
          Create account
        </Button>
      </div>
      {sessionError && <p role="alert">{sessionError.message}</p>}
      <div className="w-full max-w-sm">
        {register ? (
          <Signup01
            onSubmit={signup}
            pending={signUp.isPending}
            error={signUp.error?.message}
            onLoginClick={() => setRegister(false)}
          />
        ) : (
          <Login01
            onSubmit={login}
            pending={signIn.isPending}
            error={signIn.error?.message}
            onSignupClick={() => setRegister(true)}
          />
        )}
      </div>
    </main>
  );
}

export default function AuthApp() {
  return (
    <AuthProvider client={client}>
      <AuthContent />
    </AuthProvider>
  );
}
